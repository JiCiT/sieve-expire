# Public native builder; never used by the end-user installer.
FROM ghcr.io/docker-mailserver/docker-mailserver@sha256:d0fe7668defe157aad57ea31b1707ad1e2fb57d7a91bdf17cbdf876549946c86
USER root
# Hold exact installed runtime packages while installing build tools.
RUN dpkg-query -W -f='${binary:Package} ${db:Status-Status}\n' 'dovecot*' | awk '$2 == "installed" {print $1}' | xargs apt-mark hold
RUN apt-get update && apt-get install --no-install-recommends --no-upgrade --no-remove -y build-essential autoconf automake libtool pkgconf && rm -rf /var/lib/apt/lists/*
COPY tools/build-inputs/dovecot-dev_2.4.1+dfsg1-6+deb13u6_arm64.deb /tmp/dovecot-dev.deb
RUN echo 'e58a5436fba568a3f187368e4467a485d6a2720805ed33ecf767d812d1767851 /tmp/dovecot-dev.deb' | sha256sum -c - && dpkg -i /tmp/dovecot-dev.deb && rm /tmp/dovecot-dev.deb
WORKDIR /work
ENTRYPOINT ["/bin/bash"]
